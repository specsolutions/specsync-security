        407
      ],
      "description": ".NET denial of service vulnerability in System.Security.Cryptography.Pkcs (SignedCms.CheckSignature).",
      "published": "2026-10-13T20:03:30Z",
      "analysis": {
        "state": "not_affected",
        "justification": "requires_configuration",
        "detail": "SpecSync calls SignedCms.CheckSignature only when it verifies the signature of a SpecSync plugin package, not in its normal operation. A plugin is loaded only when the configuration names it explicitly, with its package name and version, and only at the start of the process; SpecSync never loads unknown plugins unattended. Without an explicitly configured package source, plugins are loaded from nuget.org, which validates package signatures itself. Adding a plugin is a configuration change that is tested in an interactive session, where resource exhaustion would be noticed and stopped, so the vulnerability cannot be used for a denial of service. SpecSync v5.7.0 and the next v3.4 release include version 10.0.13, which is not affected.",
        "firstIssued": "2026-11-24T18:04:21Z",
        "lastUpdated": "2026-11-25T06:26:16Z"
      },
      "affects": [
        {
          "ref": "pkg:nuget/System.Security.Cryptography.Pkcs",
          "versions": [
            {
              "range": "vers:nuget/>=8.0.0|<=8.0.1|>=9.0.0|<=9.0.20|>=10.0.0|<=10.0.12|>=11.0.0-preview.1|<=11.0.0-rc.1",
              "status": "affected"
            }
          ]
        }
      ]
    },
